# --- Server ---
PORT=3000

# --- Database (Render Postgres connection string) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Security ---
ADMIN_API_KEY=change-me-admin-key
CRON_SECRET=change-me-cron-secret
EMAIL_WEBHOOK_SECRET=change-me-email-secret

# --- RingCentral (SMS channel) ---
RC_SERVER=https://platform.ringcentral.com
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
RC_FROM_NUMBER=+15551234567
RC_WEBHOOK_URL=https://your-app.onrender.com/webhooks/ringcentral

# --- Email (optional parallel channel) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
EMAIL_FROM=offers@yourcompany.com
EMAIL_FROM_NAME=Your Company Clearance Team

# --- Company details injected into templates ---
COMPANY_NAME=Your Company
COMPANY_PHONE=(555) 555-5555
COMPANY_LICENSE=

# --- Pricing engine (placeholder defaults — tune when ready) ---
PRICING_STRATEGY=percent
PRICING_PERCENT_PER_DAY=5
PRICING_FIXED_PER_DAY=500
PRICING_FLOOR_PERCENT=50

# --- Follow-up cadence ---
FOLLOWUP_HOURS=24
FOLLOWUP_HOUR=9

# --- Optional in-process cron (only if service runs 24/7) ---
ENABLE_INTERNAL_CRON=false
